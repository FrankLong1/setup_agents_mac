# Lean, supportable baseline for a clean Mac rebuild.
brew "ansible"
brew "ansible-lint"
brew "awscli"
brew "cloud-sql-proxy"
brew "cloudflared"
brew "colima"
brew "direnv"
brew "docker"
brew "docker-buildx"
brew "docker-compose"
brew "ffmpeg"
brew "gh"
brew "git"
brew "go"
brew "graphviz"
brew "imagemagick"
brew "mas"
brew "node"
brew "oven-sh/bun/bun", trusted: true
brew "python@3.13"
brew "ripgrep"
brew "shellcheck"
brew "terraform"
brew "tmux"
brew "tree"
brew "uv"
brew "wget"
brew "yq"

cask "chatgpt"
cask "claude"
cask "codex"
cask "cursor"
cask "gcloud-cli"
cask "google-chrome"
cask "obsidian"
cask "raycast"
cask "tailscale-app"
cask "visual-studio-code"

vscode "anthropic.claude-code"
vscode "golang.go"
vscode "googlecloudtools.cloudcode"
vscode "hashicorp.terraform"
vscode "ms-python.python"
vscode "ms-python.vscode-pylance"
vscode "ms-toolsai.jupyter"
vscode "ms-vscode-remote.remote-containers"
vscode "ms-vscode-remote.remote-ssh"
