if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

{% for path in extra_path_entries %}
export PATH="{{ path }}:$PATH"
{% endfor %}

{% if shell_env_vars is defined %}
{% for item in shell_env_vars %}
export {{ item.name }}="{{ item.value }}"
{% endfor %}
{% endif %}

{% for item in shell_aliases %}
alias {{ item.alias }}='{{ item.command }}'
{% endfor %}

{% if shell_extras is defined %}
{% for item in shell_extras %}
# {{ item.name }}
{% if item.line is defined %}
{{ item.line }}
{% endif %}
{% if item.lines is defined %}
{% for line in item.lines %}
{{ line }}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}

# Machine-local additions and secrets are intentionally outside Git.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
[ -f "$HOME/.zshrc.secrets" ] && source "$HOME/.zshrc.secrets"
