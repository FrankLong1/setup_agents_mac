# Copy this to ~/.config/nas-mount-doctor.env and replace the placeholders.
# Use a dedicated, non-admin TrueNAS account. Do not put its password here:
# when you run the doctor manually for the first time, Finder asks for it and
# stores it in your login Keychain.
NAS_DATA_URLS=(
  "smb://nas-share-user@truenas-scale.tailbe754a.ts.net/files"
)

# This can instead be your NAS's Tailscale MagicDNS name (recommended) or its
# 100.x Tailscale IP, for example:
# NAS_DATA_URL="smb://nas-share-user@truenas.your-tailnet.ts.net/files"

# Optional. This is used for status reporting only: Time Machine reconnects to
# its own selected destination and should not be mounted as a regular disk.
NAS_TIME_MACHINE_URL="smb://nas-share-user@truenas-scale.tailbe754a.ts.net/timemachine"
